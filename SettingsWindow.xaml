<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WrenchDownloader.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView x:Name="SettingsTabs"
                 Grid.Row="0"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 Padding="12,12,12,0"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch">
            <TabViewItem x:Name="DownloadsTab" Header="Downloads" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Padding="16,12,16,16">
                        <TextBlock x:Name="DownloadLocationHeader" Text="Download location" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" Grid.Column="0" IsReadOnly="True" VerticalAlignment="Center" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="OnBrowseClick" VerticalAlignment="Center" />
                        </Grid>
                        <NumberBox x:Name="MaxDownloadsBox"
                                   Minimum="1" Maximum="8"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="1" LargeChange="1" />
                        <NumberBox x:Name="MaxRateBox"
                                   Minimum="0" Maximum="1000000"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="128" LargeChange="1024" />
                        <NumberBox x:Name="FragmentsBox"
                                   Minimum="1" Maximum="32"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="1" LargeChange="2" />
                        <ComboBox x:Name="QualityBox" MinWidth="240" />
                        <NumberBox x:Name="RetryBox"
                                   Minimum="0" Maximum="10"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="1" LargeChange="1" />
                        <CheckBox x:Name="ShowDialogCheck" />
                        <CheckBox x:Name="ClipboardCheck" />
                        <CheckBox x:Name="OrganizeCheck" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="BehaviorTab" Header="Behavior" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Padding="16,12,16,16">
                        <TextBlock x:Name="WindowBehaviorHeader" Text="Window behavior" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox x:Name="CloseToTrayCheck" />
                        <CheckBox x:Name="StartWithWindowsCheck" Margin="0,0,0,4" />
                        <TextBlock x:Name="PortableInfoText" TextWrapping="Wrap" Visibility="Collapsed" />

                        <Border Height="1" Margin="0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <TextBlock x:Name="CompletionHeader" Text="When a download completes" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox x:Name="ShowCompleteDialogCheck" />
                        <CheckBox x:Name="PlaySoundCheck" Margin="0,0,0,4" />

                        <Border Height="1" Margin="0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <TextBlock x:Name="ConfirmationsHeader" Text="Confirmations" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox x:Name="ConfirmRemoveCheck" />
                        <CheckBox x:Name="ConfirmDeleteCheck" Margin="0,0,0,4" />

                        <Border Height="1" Margin="0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <TextBlock x:Name="StartupHeader" Text="Startup and queue" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox x:Name="AutoResumeCheck" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="BrowsersTab" Header="Browser integration" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Padding="16,12,16,16">
                        <TextBlock x:Name="BrowserHeader" Text="Browser integration" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="BrowserHint" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <StackPanel Spacing="4" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                <Run x:Name="Step1Prefix" Text="1. Open " />
                                <Hyperlink Click="OnCopyExtensionsAddressClick"><Run Text="chrome://extensions" /></Hyperlink>
                                <Run x:Name="Step1Suffix" Text=" in Chrome." />
                            </TextBlock>
                            <TextBlock x:Name="Step2Text" TextWrapping="Wrap" />
                            <TextBlock x:Name="Step3Text" TextWrapping="Wrap" />
                            <TextBlock x:Name="Step4Text" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Google Chrome" VerticalAlignment="Center" />
                            <Button x:Name="ChromeShowFolderButton" Grid.Column="1" MinWidth="150" Click="OnShowExtensionFolderClick" />
                        </Grid>
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mozilla Firefox" VerticalAlignment="Center" />
                            <Button x:Name="FirefoxButton" Grid.Column="1" MinWidth="110" IsEnabled="False" />
                        </Grid>
                        <TextBlock x:Name="BrowserStatusText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="AppearanceTab" Header="Appearance" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Padding="16,12,16,16">
                        <TextBlock x:Name="ThemeHeader" Text="Display mode" FontWeight="SemiBold" />
                        <ComboBox x:Name="ThemeBox" MinWidth="240" SelectionChanged="OnThemeSelectionChanged" />
                        <TextBlock x:Name="ThemeHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Height="1" Margin="0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="LanguageHeader" Text="Application language" FontWeight="SemiBold" />
                        <TextBlock x:Name="LanguageHint" TextWrapping="Wrap" />
                        <ComboBox x:Name="LanguageBox" MinWidth="240" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Click="OnCancelClick" />
                <Button x:Name="SaveButton" Content="Save" Style="{ThemeResource AccentButtonStyle}" MinWidth="90" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
