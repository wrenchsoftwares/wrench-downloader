<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WrenchDownloader.TorrentFilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WrenchDownloader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Torrent Files"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24,18">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Torrent Files" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TorrentNameTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="TorrentSummaryTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel x:Name="ResolvingPanel" Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="ResolvingRing" Width="20" Height="20" IsActive="True" />
                <TextBlock Text="Resolving torrent file list…" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SelectAllButton" Content="Select all" Click="OnSelectAllClick" />
                <Button x:Name="SelectNoneButton" Content="Select none" Click="OnSelectNoneClick" />
            </StackPanel>

            <ListView x:Name="FilesList" SelectionMode="None" MaxHeight="340">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" MaxWidth="380" />
                                <TextBlock Text="{Binding SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" MinWidth="90" />
                <Button x:Name="StartButton" Content="Start Download" Style="{ThemeResource AccentButtonStyle}" Click="OnStartClick" MinWidth="130" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
