<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WrenchDownloader.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WrenchDownloader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
            <TextBlock Text="🔧 Wrench Downloader" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="High-speed multi-part file and video grabber" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            
            <TextBox x:Name="UrlTextBox" PlaceholderText="Paste download or video stream URL (e.g. .m3u8, .mp4, direct link)..." />
            
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="Add Download" Style="{ThemeResource AccentButtonStyle}" Click="OnAddDownloadClick" />
                <Button Content="Grab Video" Click="OnGrabVideoClick" />
            </StackPanel>

            <ProgressBar x:Name="TestProgressBar" Value="65" Maximum="100" Margin="0,10,0,0" />
            <TextBlock x:Name="StatusTextBlock" Text="Ready to download. Extension bridge listening..." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
